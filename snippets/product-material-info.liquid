{% comment %}
  Renders material summary rows (Diamond Color, Gold Color, Gemstone Color)
  for the main product page, below the Worldwide shipping link.

  Accepts:
  - product: {Object} product object.
  - section_id: {String} The ID of the section that contains this block,
    used so the variant-switching JS can find and refresh this block.

  Usage:
  {% render 'product-material-info', product: product, section_id: section.id %}
{% endcomment %}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign diamond_colors = ''
  for entry in current_variant.metafields.custom.diamond_color.value
    assign diamond_name = entry.name_of_color.value
    if diamond_name != blank
      assign diamond_color = diamond_name | split: ' ' | first
      if diamond_colors == blank
        assign diamond_colors = diamond_color
      else
        assign diamond_colors = diamond_colors | append: '|' | append: diamond_color
      endif
    endif
  endfor
  assign diamond_color_list = diamond_colors | split: '|'

  assign diamond_text = ''
  for color in diamond_color_list
    if forloop.first
      assign diamond_text = color
    elsif forloop.last
      assign diamond_text = diamond_text | append: ' and ' | append: color
    else
      assign diamond_text = diamond_text | append: ', ' | append: color
    endif
  endfor
  unless diamond_text == blank
    assign diamond_text = diamond_text | append: ' Diamonds'
  endunless

  assign gold_color_count = product.metafields.custom.gold_color.value.size
  assign gold_text = ''
  if gold_color_count == 1
    for entry in product.metafields.custom.gold_color.value
      assign gold_text = '18K ' | append: entry.name.value
    endfor
  elsif gold_color_count > 1
    assign gold_text = '18K Gold'
  endif

  assign gemstone_count = product.metafields.custom.locks_gemstone_color.value.size

  assign unique_components = product.metafields.custom.unique_components.value
  assign unique_component_names = ''
  if unique_components and unique_components.size > 0
    for unique_component in unique_components
      assign unique_component_names = unique_component_names | append: unique_component.unique_component.value
      unless forloop.last
        assign unique_component_names = unique_component_names | append: ', '
      endunless
    endfor
  endif
-%}
{%- if diamond_text != blank or gold_text != blank or gemstone_count > 0 or unique_component_names != blank -%}
  <div class="product-material-info" id="product-material-info-{{ section_id }}">
    {%- if diamond_text != blank -%}
      <div class="product-material-info__row">
        <span class="svg-wrapper">{{- 'icon-diamond.svg' | inline_asset_content -}}</span>
        <span>{{ diamond_text }}</span>
      </div>
    {%- endif -%}
    {%- if gold_text != blank -%}
      <div class="product-material-info__row">
        <span class="svg-wrapper">{{- 'icon-gold-bar.svg' | inline_asset_content -}}</span>
        <span>{{ gold_text }}</span>
      </div>
    {%- endif -%}
    {%- if gemstone_count > 0 -%}
      <div class="product-material-info__row">
        <span class="svg-wrapper">{{- 'icon-gemstone.svg' | inline_asset_content -}}</span>
        <span>
          {%- if gemstone_count == 1 -%}
            {{- gemstone_count }} type of Gemstone
          {%- else -%}
            {{- gemstone_count }} types of Gemstones
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}
    {%- if unique_component_names != blank -%}
      <div class="product-material-info__row">
        <span class="svg-wrapper">{{- 'icon-unique-component.svg' | inline_asset_content -}}</span>
        <span>{{ 'products.product.contains_unique_component' | t: components: unique_component_names }}</span>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
