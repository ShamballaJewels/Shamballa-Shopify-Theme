{% comment %}
  Renders material summary rows (Diamond Color, Gold Color, Gemstone Color)
  for the main product page, below the Worldwide shipping link.

  Accepts:
  - product: {Object} product object.

  Usage:
  {% render 'product-material-info', product: product %}
{% endcomment %}
{%- liquid
  assign diamond_text = ''
  for entry in product.metafields.custom.diamond_color.value
    assign diamond_name = entry.name_of_color.value
    if diamond_name != blank
      assign diamond_name = diamond_name | append: 's'
      if diamond_text == blank
        assign diamond_text = diamond_name
      else
        assign diamond_text = diamond_text | append: ', ' | append: diamond_name
      endif
    endif
  endfor

  assign gold_text = ''
  for entry in product.metafields.custom.gold_color.value
    assign gold_name = entry.name.value
    if gold_name != blank
      assign gold_name = '18K ' | append: gold_name
      if gold_text == blank
        assign gold_text = gold_name
      else
        assign gold_text = gold_text | append: ', ' | append: gold_name
      endif
    endif
  endfor

  assign gemstone_count = product.metafields.custom.locks_gemstone_color.value.size
-%}
{%- if diamond_text != blank or gold_text != blank or gemstone_count > 0 -%}
  <div class="product-material-info">
    {%- if diamond_text != blank -%}
      <div class="product-material-info__row">
        <span class="svg-wrapper">{{- 'icon-diamond.svg' | inline_asset_content -}}</span>
        <span>{{ diamond_text }}</span>
      </div>
    {%- endif -%}
    {%- if gold_text != blank -%}
      <div class="product-material-info__row">
        <span class="svg-wrapper">{{- 'icon-gold-bar.svg' | inline_asset_content -}}</span>
        <span>{{ gold_text }}</span>
      </div>
    {%- endif -%}
    {%- if gemstone_count > 0 -%}
      <div class="product-material-info__row">
        <span class="svg-wrapper">{{- 'icon-gemstone.svg' | inline_asset_content -}}</span>
        <span>
          {{- gemstone_count }} types of gemstone{% if gemstone_count > 1 %}s{% endif -%}
        </span>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
