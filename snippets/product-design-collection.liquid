{% comment %}
  Renders a link to the product's design collection (a collection flagged with
  the custom.is_design_collection metafield), e.g. "Spring/Summer 2026",
  distinct from generic type collections like "Beaded Bracelets" or "All Bracelets".

  Accepts:
  - product: {Object} product object.

  Usage:
  {% render 'product-design-collection', product: product %}
{% endcomment %}
{%- liquid
  assign design_collection = blank
  for collection in product.collections
    if collection.metafields.custom.is_design_collection.value
      assign design_collection = collection
      break
    endif
  endfor
-%}
{%- if design_collection != blank -%}
  <a href="{{ design_collection.url }}" class="product__design-collection">
    {{- design_collection.title | escape -}}
  </a>
{%- endif -%}
<pre style="font-size:1.1rem;white-space:pre-wrap;background:#eee;padding:1rem;">DEBUG
design_collection found: {{ design_collection.title | default: 'NONE' }}
product.collections.size: {{ product.collections.size }}
{%- for collection in product.collections %}
- {{ collection.title }} | metafield value: [{{ collection.metafields.custom.is_design_collection.value | json }}]
{%- endfor %}
</pre>
