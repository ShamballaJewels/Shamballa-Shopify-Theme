{% comment %}
  Renders small square icons for a product's Diamond Color, Gemstone Color,
  and Gold Color metafields, reusing the icon/image already set on each
  metaobject entry (no new icons need to be uploaded). Gold Color is always
  listed last. When Gold Color is a real variant option on the product, the
  entry matching the currently displayed variant gets a dark rim, and the
  other entries link to the matching variant (same other option values,
  different gold color).

  Accepts:
  - card_product: {Object} product object.
  - layout: {String} 'overlay' (default, floats on the product photo) or
    'inline' (a plain row below the photo, used on mobile so the icons
    don't cover the image).
  - display_variant: {Object} Variant Liquid object (optional). When present,
    this variant (rather than the product's selected/first available variant)
    is treated as "currently shown" for the Gold Color and Diamond Color
    icons, which are variant-specific.

  Usage:
  {% render 'card-product-attribute-icons', card_product: card_product, layout: 'inline' %}
{% endcomment %}
{%- liquid
  assign current_variant = card_product.selected_or_first_available_variant
  if display_variant
    assign current_variant = display_variant
  endif
  assign diamond_entry = current_variant.metafields.custom.diamond_color.value

  assign gold_option_position = 0
  for option in card_product.options_with_values
    if option.name == 'Gold Color'
      assign gold_option_position = forloop.index
    endif
  endfor
  if gold_option_position == 1
    assign gold_option_key = 'option1'
  elsif gold_option_position == 2
    assign gold_option_key = 'option2'
  elsif gold_option_position == 3
    assign gold_option_key = 'option3'
  endif

  # Only show the gold color of the variant this card is actually showing,
  # not every gold color the product offers.
  assign gold_entry = null
  if gold_option_position > 0
    assign current_gold_value = current_variant[gold_option_key]
    for entry in card_product.metafields.custom.gold_color.value
      if entry.name.value == current_gold_value
        assign gold_entry = entry
        break
      endif
    endfor
  else
    for entry in card_product.metafields.custom.gold_color.value
      assign gold_entry = entry
      break
    endfor
  endif

  assign has_icons = false
  if diamond_entry
    assign has_icons = true
  endif
  if gold_entry
    assign has_icons = true
  endif
  if card_product.metafields.custom.locks_gemstone_color.value.size > 0
    assign has_icons = true
  endif

  if layout == blank
    assign layout = 'overlay'
  endif
-%}
{%- if has_icons -%}
  <div class="card-product-attribute-icons card-product-attribute-icons--{{ layout }}">
    {%- if diamond_entry -%}
      {%- assign icon_image = diamond_entry.color.value -%}
      {%- assign icon_label = diamond_entry.name_of_color.value -%}
      {%- if icon_image != blank -%}
        <span class="card-product-attribute-icon" data-label="{{ icon_label | escape }}">
          <span class="card-product-attribute-icon__image">
            {{ icon_image | image_url: width: 60 | image_tag: loading: 'lazy', alt: icon_label, sizes: '2.4rem' }}
          </span>
          <span class="card-product-attribute-icon__label">{{ icon_label | escape }}</span>
        </span>
      {%- endif -%}
    {%- endif -%}

    {%- for entry in card_product.metafields.custom.locks_gemstone_color.value -%}
      {%- assign icon_image = entry.image.value -%}
      {%- assign icon_label = entry.name.value -%}
      {%- if icon_image != blank -%}
        <span class="card-product-attribute-icon" data-label="{{ icon_label | escape }}">
          <span class="card-product-attribute-icon__image">
            {{ icon_image | image_url: width: 60 | image_tag: loading: 'lazy', alt: icon_label, sizes: '2.4rem' }}
          </span>
          <span class="card-product-attribute-icon__label">{{ icon_label | escape }}</span>
        </span>
      {%- endif -%}
    {%- endfor -%}

    {%- if gold_entry -%}
      {%- assign icon_image = gold_entry.image.value -%}
      {%- assign icon_label = gold_entry.name.value -%}
      {%- if icon_image != blank -%}
        <span class="card-product-attribute-icon" data-label="{{ icon_label | escape }}">
          <span class="card-product-attribute-icon__image">
            {{ icon_image | image_url: width: 60 | image_tag: loading: 'lazy', alt: icon_label, sizes: '2.4rem' }}
          </span>
          <span class="card-product-attribute-icon__label">{{ icon_label | escape }}</span>
        </span>
      {%- endif -%}
    {%- endif -%}
    <div class="card-product-attribute-icons__active-label" aria-hidden="true"></div>
  </div>
{%- endif -%}
