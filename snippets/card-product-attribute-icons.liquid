{% comment %}
  Renders small square icons for a product's Diamond Color, Gold Color, and
  Gemstone Color metafields, reusing the icon/image already set on each
  metaobject entry (no new icons need to be uploaded).

  Accepts:
  - card_product: {Object} product object.

  Usage:
  {% render 'card-product-attribute-icons', card_product: card_product %}
{% endcomment %}
{%- liquid
  assign has_icons = false
  if card_product.metafields.custom.diamond_color.value.size > 0
    assign has_icons = true
  endif
  if card_product.metafields.custom.gold_color.value.size > 0
    assign has_icons = true
  endif
  if card_product.metafields.custom.locks_gemstone_color.value.size > 0
    assign has_icons = true
  endif
-%}
{%- if has_icons -%}
  <div class="card-product-attribute-icons">
    {%- for entry in card_product.metafields.custom.diamond_color.value -%}
      {%- assign icon_image = entry.color.value -%}
      {%- assign icon_label = entry.name_of_color.value -%}
      {%- if icon_image != blank -%}
        <span class="card-product-attribute-icon">
          <span class="card-product-attribute-icon__image">
            {{ icon_image | image_url: width: 60 | image_tag: loading: 'lazy', alt: icon_label, sizes: '2.4rem' }}
          </span>
          <span class="card-product-attribute-icon__label">{{ icon_label | escape }}</span>
        </span>
      {%- endif -%}
    {%- endfor -%}

    {%- for entry in card_product.metafields.custom.gold_color.value -%}
      {%- assign icon_image = entry.image.value -%}
      {%- assign icon_label = entry.name.value -%}
      {%- if icon_image != blank -%}
        <span class="card-product-attribute-icon">
          <span class="card-product-attribute-icon__image">
            {{ icon_image | image_url: width: 60 | image_tag: loading: 'lazy', alt: icon_label, sizes: '2.4rem' }}
          </span>
          <span class="card-product-attribute-icon__label">{{ icon_label | escape }}</span>
        </span>
      {%- endif -%}
    {%- endfor -%}

    {%- for entry in card_product.metafields.custom.locks_gemstone_color.value -%}
      {%- assign icon_image = entry.image.value -%}
      {%- assign icon_label = entry.name.value -%}
      {%- if icon_image != blank -%}
        <span class="card-product-attribute-icon">
          <span class="card-product-attribute-icon__image">
            {{ icon_image | image_url: width: 60 | image_tag: loading: 'lazy', alt: icon_label, sizes: '2.4rem' }}
          </span>
          <span class="card-product-attribute-icon__label">{{ icon_label | escape }}</span>
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
