{%- comment -%}
  Renders the Materials list dynamically from the product's gemstone, gold and
  diamond color metaobject references, instead of a manually typed metafield.

  Each gemstone reference shows "Name: description", with the name linking to
  the gemstone's own page (Content > Metaobjects > Gemstones has Online Store
  pages enabled). Gold/diamond colors are listed by name; add a "description"
  field to those metaobject definitions later to give them the same treatment.

  Usage: {% render 'product-materials-dynamic', product: product %}
{%- endcomment -%}
<ul class="product-materials-list list-unstyled">
  {%- for gemstone in product.metafields.custom.locks_gemstone_color.value -%}
    <li class="product-materials-list__item">
      {%- if gemstone.url -%}
        <a href="{{ gemstone.url }}">{{ gemstone.name.value }}</a>
      {%- else -%}
        <strong>{{ gemstone.name.value }}</strong>
      {%- endif -%}
      {%- if gemstone.description.value != blank -%}
        : {{ gemstone.description.value }}
      {%- endif -%}
    </li>
  {%- endfor -%}

  {%- for gold in product.metafields.custom.gold_color.value -%}
    <li class="product-materials-list__item">
      {%- if gold.url -%}
        <a href="{{ gold.url }}">{{ gold.name.value }}</a>
      {%- else -%}
        <strong>{{ gold.name.value }}</strong>
      {%- endif -%}
      {%- if gold.description.value != blank -%}
        : {{ gold.description.value }}
      {%- endif -%}
    </li>
  {%- endfor -%}

  {%- for diamond in product.metafields.custom.diamond_color.value -%}
    <li class="product-materials-list__item">
      {%- if diamond.url -%}
        <a href="{{ diamond.url }}">{{ diamond.name_of_color.value }}</a>
      {%- else -%}
        <strong>{{ diamond.name_of_color.value }}</strong>
      {%- endif -%}
      {%- if diamond.description.value != blank -%}
        : {{ diamond.description.value }}
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
