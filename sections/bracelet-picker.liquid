{{ 'component-bracelet-picker.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bracelet-picker.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign picker_collection = collections[section.settings.collection] -%}

<div class="bracelet-picker-section color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="bracelet-picker__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="bracelet-picker__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if picker_collection == blank -%}
      <p class="bracelet-picker__empty">
        {{ 'sections.bracelet_picker.no_collection' | t }}
      </p>
    {%- else -%}
      <bracelet-picker class="bracelet-picker">
        <script type="application/json" data-bracelet-picker-config>
          {
            "collectionUrl": {{ picker_collection.url | json }},
            "steps": [
              { "param": "filter.p.m.custom.bracelet_type", "label": "Bracelet Type", "hasImages": true },
              { "param": "filter.p.m.custom.end_beads", "label": "End Beads", "hasImages": true },
              { "param": "filter.p.m.custom.bead_size", "label": "Bead Size", "hasImages": true }
            ],
            "text": {
              "back": {{ section.settings.back_label | json }},
              "skip": {{ section.settings.skip_label | json }},
              "restart": {{ section.settings.restart_label | json }},
              "empty": {{ section.settings.empty_results_text | json }}
            }
          }
        </script>

        <div class="bracelet-picker__wizard" data-picker-wizard>
          <div class="bracelet-picker__progress" data-picker-progress></div>
          <h3 class="bracelet-picker__step-label" data-picker-step-label></h3>
          <div class="bracelet-picker__options" data-picker-options></div>
          <div class="bracelet-picker__nav">
            <button type="button" class="link bracelet-picker__back" data-picker-back hidden></button>
            <button type="button" class="link bracelet-picker__skip" data-picker-skip></button>
          </div>
        </div>

        <div class="bracelet-picker__results" data-picker-results hidden></div>

        <div class="bracelet-picker__loading" data-picker-loading hidden>
          {%- render 'loading-spinner' -%}
        </div>
      </bracelet-picker>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Bracelet picker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your bracelet"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Answer a few quick questions to discover the styles made for you"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to search",
      "info": "Must have Search & Discovery filters enabled for Bracelet Type, End Beads and Bead Size."
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back button label",
      "default": "Back"
    },
    {
      "type": "text",
      "id": "skip_label",
      "label": "Skip button label",
      "default": "Skip this question"
    },
    {
      "type": "text",
      "id": "restart_label",
      "label": "Restart button label",
      "default": "Start over"
    },
    {
      "type": "text",
      "id": "empty_results_text",
      "label": "No matches text",
      "default": "We couldn't find a bracelet matching all of your choices. Try starting over with fewer selections."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Bracelet picker"
    }
  ]
}
{% endschema %}
