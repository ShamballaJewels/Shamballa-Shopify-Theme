{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .storytelling-multicolumn-{{ section.id }}__heading {
    max-width: 80rem;
    margin: 0 0 4rem;
  }

  .storytelling-multicolumn-{{ section.id }}__columns {
    margin-bottom: 4rem;
  }

  .storytelling-multicolumn-{{ section.id }}__column-heading {
    margin: 0 0 1.2rem;
  }

  .storytelling-multicolumn-{{ section.id }}__column-text {
    margin: 0;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank -%}
      <div class="storytelling-multicolumn-{{ section.id }}__heading">
        <h2 class="inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endunless -%}

    <div class="grid grid--3-col-desktop grid--1-col-tablet-down storytelling-multicolumn-{{ section.id }}__columns">
      {%- for block in section.blocks -%}
        {%- if block.type == 'text_column' -%}
          <div class="grid__item" {{ block.shopify_attributes }}>
            {%- unless block.settings.heading == blank -%}
              <h3 class="storytelling-multicolumn-{{ section.id }}__column-heading h5">
                {{ block.settings.heading | escape }}
              </h3>
            {%- endunless -%}
            {%- unless block.settings.text == blank -%}
              <div class="storytelling-multicolumn-{{ section.id }}__column-text rte">
                {{ block.settings.text }}
              </div>
            {%- endunless -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="grid grid--4-col-desktop grid--2-col-tablet-down">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' -%}
          <div class="grid__item" {{ block.shopify_attributes }}>
            <div class="media media--landscape">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400, 500, 600, 700, 800',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Storytelling multicolumn",
  "class": "section",
  "tag": "section",
  "enabled_on": {
    "templates": ["collection", "product"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "It holds the philosophy without lecturing on Buddhism, and sells without listing.",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "text_column",
      "name": "Text column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Column heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Describe this part of the story.</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Storytelling multicolumn",
      "blocks": [
        {
          "type": "text_column"
        },
        {
          "type": "text_column"
        },
        {
          "type": "text_column"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
