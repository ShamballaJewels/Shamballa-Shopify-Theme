{{ 'component-breadcrumbs.css' | asset_url | stylesheet_tag }}

<div class="gemstone-detail color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- render 'breadcrumbs', current_title: metaobject.name.value, collection_object: pages['gemstones'] -%}

    <div class="gemstone-detail__grid grid grid--1-col-tablet-down grid--2-col-desktop">
      <div class="gemstone-detail__media grid__item">
        <div class="gemstone-detail__image-wrapper">
          {%- if metaobject.image.value -%}
            {{
              metaobject.image.value
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                widths: '533, 720, 900, 1000',
                sizes: '(min-width: 750px) 50vw, 100vw',
                class: 'gemstone-detail__image',
                alt: metaobject.name.value
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg gemstone-detail__image' }}
          {%- endif -%}
        </div>
      </div>
      <div class="gemstone-detail__content grid__item">
        <p class="gemstone-detail__eyebrow caption-with-letter-spacing">{{ 'sections.main-gemstone.eyebrow' | t }}</p>
        <h1 class="gemstone-detail__title title h0">{{ metaobject.name.value }}</h1>
        {%- if metaobject.gemstone_description.value != blank -%}
          <div class="rte gemstone-detail__description">{{ metaobject.gemstone_description.value | newline_to_br }}</div>
        {%- endif -%}
        <a href="/pages/gemstones" class="link gemstone-detail__back caption-with-letter-spacing">
          &larr; {{ 'sections.main-gemstone.back_link' | t }}
        </a>
      </div>
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .gemstone-detail {
    background-color: transparent !important;
    background-image: none !important;
  }

  .gemstone-detail .breadcrumbs {
    margin-bottom: 3.5rem;
  }

  .gemstone-detail__grid {
    align-items: center;
  }

  .gemstone-detail__image-wrapper {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    background-color: rgba(var(--color-foreground), 0.06);
  }

  .gemstone-detail__image,
  .gemstone-detail__image-wrapper .placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gemstone-detail__content {
    margin-top: 3rem;
    max-width: 44rem;
  }

  @media screen and (min-width: 990px) {
    .gemstone-detail__content {
      margin-top: 0;
      padding-left: 2rem;
    }
  }

  .gemstone-detail__eyebrow {
    margin: 0 0 1rem;
    color: rgba(var(--color-foreground), 0.6);
  }

  .gemstone-detail__title {
    margin: 0 0 2.5rem;
  }

  .gemstone-detail__description {
    margin: 0 0 3.5rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
    color: rgba(var(--color-foreground), 0.8);
  }

  .gemstone-detail__description p + p {
    margin-top: 1.5rem;
  }

  .gemstone-detail__back {
    display: inline-block;
    padding-top: 2rem;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.12);
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Gemstone detail",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 48 }
  ]
}
{% endschema %}
