<div class="page-width section-{{ section.id }}-padding gemstone-detail">
  <div class="gemstone-detail__grid grid grid--2-col-tablet-up">
    <div class="gemstone-detail__media grid__item">
      {%- if metaobject.image.value -%}
        {{ metaobject.image.value | image_url: width: 900 | image_tag: loading: 'lazy', alt: metaobject.name.value }}
      {%- endif -%}
    </div>
    <div class="gemstone-detail__content grid__item">
      <h1>{{ metaobject.name.value }}</h1>
      {%- if metaobject.description.value != blank -%}
        <div class="rte gemstone-detail__description">{{ metaobject.description.value | newline_to_br }}</div>
      {%- endif -%}
      <a href="/pages/gemstones" class="link underlined-link gemstone-detail__back">&larr; Back to all gemstones</a>
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .gemstone-detail__grid {
    align-items: start;
  }
  .gemstone-detail__media img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .gemstone-detail__description {
    margin: 1.5rem 0;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Gemstone detail",
  "settings": [
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ]
}
{% endschema %}
