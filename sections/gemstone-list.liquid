<div class="page-width section-{{ section.id }}-padding">
  <div class="gemstone-list__header">
    <h1 class="gemstone-list__title">{{ section.settings.heading | default: 'Our Gemstones' }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="gemstone-list__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}
  </div>

  {%- assign gemstones = shop.metaobjects.gemstone_color.values -%}
  <div class="gemstone-list__grid grid grid--3-col-desktop grid--2-col-tablet-down">
    {%- for gemstone in gemstones -%}
      <a href="{{ gemstone.system.url | default: '#' }}" class="gemstone-list__card">
        {%- if gemstone.image.value -%}
          {{ gemstone.image.value | image_url: width: 600 | image_tag: loading: 'lazy', alt: gemstone.name.value }}
        {%- endif -%}
        <h2 class="gemstone-list__card-title h4">{{ gemstone.name.value }}</h2>
        {%- if gemstone.description.value != blank -%}
          <p class="gemstone-list__card-excerpt">{{ gemstone.description.value | truncate: 120 }}</p>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .gemstone-list__header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .gemstone-list__grid {
    row-gap: 3rem;
  }
  .gemstone-list__card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .gemstone-list__card img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    margin-bottom: 1rem;
  }
  .gemstone-list__card-title {
    margin-bottom: 0.5rem;
  }
  .gemstone-list__card-excerpt {
    color: rgb(var(--color-foreground));
    opacity: 0.75;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Gemstone list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Gemstones" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "presets": [{ "name": "Gemstone list" }]
}
{% endschema %}
