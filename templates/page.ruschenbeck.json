t_size":"medium"}},"heading_6ppfAQ":{"type":"heading","settings":{"heading":"rüschenbeck","heading_size":"h2"}},"text_deWkFV":{"type":"text","settings":{"text":"<p>The Rüschenbeck boutique in Frankfurt am Main is located in the middle of the city, near Goethestrasse and the popular gourmet mile Freßgass. On over 450 m² and two floors, the boutique present the world of exclusive jewelry and world-famous watch brands.<br\/>Discover your new dream watch or your new favorite piece of jewelry with a glass of champagne in a luxurious atmosphere.<\/p><p>Opening hours:<br\/>Monday – Friday: 10:00 – 19:00<br\/>Saturday: 10:00 – 18:00<br\/>Sunday and Holidays: Closed<br\/><\/p><p><a href=\"https:\/\/www.google.com\/maps\/place\/Jeweler+R%C3%BCschenbeck+in+Frankfurt\/@50.1143322,8.6767675,723m\/data=!3m2!1e3!4b1!4m6!3m5!1s0x47bd0eae674c0bcf:0xdb8531aa750e3dd!8m2!3d50.1143322!4d8.6767675!16s%2Fg%2F1wnbx3r4?hl=da&entry=ttu&g_ep=EgoyMDI0MTAyMS4xIKXMDSoASAFQAw%3D%3D\" target=\"_blank\" title=\"https:\/\/www.google.com\/maps\/place\/Jeweler+R%C3%BCschenbeck+in+Frankfurt\/@50.1143322,8.6767675,723m\/data=!3m2!1e3!4b1!4m6!3m5!1s0x47bd0eae674c0bcf:0xdb8531aa750e3dd!8m2!3d50.1143322!4d8.6767675!16s%2Fg%2F1wnbx3r4?hl=da&entry=ttu&g_ep=EgoyMDI0MTAyMS4xIKXMDSoASAFQAw%3D%3D\">Börsenstraße 2-4<br\/>60313 Frankfurt, Germany<\/a><\/p>","text_style":"body"}}},"block_order":["caption_a64NDb","heading_6ppfAQ","text_deWkFV"],"custom_css":[".image-with-text__content.image-with-text__content--middle.image-with-text__content--desktop-left.image-with-text__content--mobile-left.image-with-text__content--adapt.content-container.gradient.color-background-1 {background-image: none !important; background-color: #ffffff !important;}"],"settings":{"image":"shopify:\/\/shop_images\/5f699907dce75efdc532e1c3ecadb929.jpg","height":"adapt","desktop_image_width":"large","layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":0,"padding_bottom":36}},"image_with_text_GbXGFA":{"type":"image-with-text","blocks":{"caption_mXR6k8":{"type":"caption","settings":{"caption":"Kitzbühel, Austria","text_style":"subtitle","text_size":"medium"}},"heading_4V6JYz":{"type":"heading","settings":{"heading":"Rüschenbeck","heading_size":"h2"}},"text_bTQPNW":{"type":"text","settings":{"text":"<p>In the middle of the mountains, on the legendary Hahnenkamm downhill run in the Tyrolean luxury ski resort of Kitzbühel, we welcome you in a rustic, comfortable atmosphere. The Rüschenbeck jeweler in Kitzbühel combines modernity and tradition.<\/p><p>Opening hours:<br\/>Monday – Friday: 10:00 – 18:00<br\/>Saturday: Closed<br\/>Sunday and Holidays: Closed<\/p><p><a href=\"https:\/\/www.google.com\/maps\/place\/Juwelier+R%C3%BCschenbeck\/@47.4466596,12.3878451,762m\/data=!3m2!1e3!4b1!4m6!3m5!1s0x47764d75c3a97133:0x73997bd3be9dcea3!8m2!3d47.446656!4d12.39042!16s%2Fg%2F11cs6k0g99?entry=ttu&g_ep=EgoyMDI0MTAyMS4xIKXMDSoASAFQAw%3D%3D\" target=\"_blank\" title=\"Rüschenbeck Kitzbühel\">Hinterstadt 9<br\/>6370 Kitzbühel, Austria<\/a><\/p>","text_style":"body"}}},"block_order":["caption_mXR6k8","heading_4V6JYz","text_bTQPNW"],"custom_css":[".image-with-text__content.image-with-text__content--middle.image-with-text__content--desktop-left.image-with-text__content--mobile-left.image-with-text__content--adapt.content-container.gradient.color-background-1 {background-image: none !important; background-color: #ffffff !important;}"],"settings":{"image":"shopify:\/\/shop_images\/1a1d7bc2c6f23ebb721eab751c489d33.jpg","height":"adapt","desktop_image_width":"large","layout":"text_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}}},"order":["main","slideshow