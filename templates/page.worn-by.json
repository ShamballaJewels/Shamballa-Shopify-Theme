nding_page_url":"","title_button":"Test","url_button":"\/"}},"template--19747420373328__5fe6985f-109d-4bb6-a3c5-9635679fab22-column-2":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/ourcollectors_1.jpg","title":"Karl Lagerfeld","text":"<p>Karl Lagerfeld was a renowned German fashion designer known for his iconic role as creative director at Chanel and Fendi. His distinctive style and influence left a lasting mark on the fashion world. He passed away in February 2019.<\/p>","link_label":"","link":"","landing_page_url":"","title_button":"Test","url_button":"\/"}},"template--19747420373328__5fe6985f-109d-4bb6-a3c5-9635679fab22-column-3":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/ourcollectors_2.jpg","title":"Holger Rune","text":"<p>Holger Rune is a Danish professional tennis player who has been ranked as world No. 4 in men's singles by ATP, making him the highest-ranked male Danish player in the history of these rankings.<\/p>","link_label":"","link":"","landing_page_url":"","title_button":"Test","url_button":"\/"}},"e5e6e49b-13ff-4f40-a213-599b33f4b4c0":{"type":"column","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/ourcollectors_3.jpg","title":"Valentino","text":"<p>Valentino Garavani is an Italian fashion designer who founded the Valentino fashion brand in 1960. Since then, the brand has gained international recognition and it is often connected with the Italian timeless style and elegance.<\/p>","link_label":"","link":"","landing_page_url":"","title_button":"Test","url_button":"\/"}}},"block_order":["template--19747420373328__5fe6985f-109d-4bb6-a3c5-9635679fab22-column-1","template--19747420373328__5fe6985f-109d-4bb6-a3c5-9635679fab22-column-2","template--19747420373328__5fe6985f-109d-4bb6-a3c5-9635679fab22-column-3","e5e6e49b-13ff-4f40-a213-599b33f4b4c0"],"custom_css":[".multicolumn-card__image-wrapper a {pointer-events: none;}",".multicolumn-card__image-wrapper a img {transform: scale(1); max-width: 100%; height: