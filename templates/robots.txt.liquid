{%- assign allowed_paths = '/cart,/*/cart,/carts,/*/carts' | split: ',' -%}

{% for group in robots.default_groups %}
  {{- group.user_agent }}

  {%- for rule in group.rules -%}
    {% comment %} {{ rule }} {% endcomment %}

    {%- unless rule.directive == 'Disallow' and allowed_paths contains rule.value -%}
      {{ rule }}
    {%- endunless -%}
  {%- endfor -%}

  {%- if group.user_agent.value == '*' -%}
    Disallow: /*?*pr_prod_strat=
    Disallow: /*?*pr_rec_id=
    Disallow: /*?*pr_rec_pid=
    Disallow: /*?*pr_ref_pid=
    Disallow: /*?*pr_seq=
  {%- endif %}

  {%- if group.sitemap != blank %}
    {{ group.sitemap }}
  {%- endif %}
{% endfor %}