smed gram","heading_size":"h2"}},"text_deWkFV":{"type":"text","settings":{"text":"<p>Guldsmed Gram in Vejle is a distinguished retailer of Shamballa Jewels, located in the heart of the city. Known for its dedication to quality and exceptional craftsmanship, Guldsmed Gram offers a curated selection of fine jewelry, including the iconic Shamballa creations. Step into this elegant boutique and explore our signature bracelets, necklaces, and rings—each piece blending spiritual symbolism with luxurious materials. With personalized service in a refined setting, Guldsmed Gram provides a unique experience for those seeking Shamballa Jewels' timeless artistry in Vejle.<\/p><p><strong>Opening hours:<\/strong><br\/>Monday - Thursday: 10.00-17.00<br\/>Friday: 10-18<br\/>Staturday: 10-15<br\/>Sunday and Holidays: Closed<\/p><p><a href=\"https:\/\/www.google.gr\/maps\/place\/Guldsmed+Gram\/@55.7096194,9.5309775,17z\/data=!3m1!4b1!4m6!3m5!1s0x464c8251e9c534d1:0xf353e5c49a10bdf1!8m2!3d55.7096164!4d9.5335524!16s%2Fg%2F11bwnd0m30?hl=en&entry=ttu&g_ep=EgoyMDI0MTAyMi4wIKXMDSoASAFQAw%3D%3D\" target=\"_blank\" title=\"Guldsmed Gram Vejle\">Torvegade 38, <br\/>7100 Vejle, Denmark<\/a><\/p>","text_style":"body"}}},"block_order":["caption_a64NDb","heading_6ppfAQ","text_deWkFV"],"custom_css":[".image-with-text__content.image-with-text__content--middle.image-with-text__content--desktop-left.image-with-text__content--mobile-left.image-with-text__content--adapt.content-container.gradient.color-background-1 {background-image: none !important; background-color: #ffffff !important;}"],"settings":{"image":"shopify:\/\/shop_images\/Shamballa_butik_afdeling.webp","height":"adapt","desktop_image_width":"large","layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":28,"padding_bottom":36}}},"order":["main","slideshow_D3giif