    "multirow_NbVjMD": {
      "type": "multirow",
      "blocks": {
        "row_4aR9nn": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/inside_sj_1.jpg",
            "caption": "Exclusive Beaded",
            "heading": "Jewelry Crafted in Copenhagen",
            "text": "<p>Our exclusive range of beaded bracelets and necklaces, including the 6mm and 10mm<br/>SHAMBALLA® Lock Bracelets, are beautifully handcrafted in Copenhagen from 18<br/>karat gold. Adorned with a rich combination of brown and G/Vs diamonds,<br/>tanzanites, and aquamarines, these pieces offer a timeless elegance that is perfect<br/>for any occasion, adding a touch of everyday luxury and sophistication.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "row_9htTqi": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/inside_sj_6.jpg",
            "caption": "Adorned with",
            "heading": "Diamonds and Precious Stones",
            "text": "<p>The new collection features bracelets enriched with the finest diamonds and precious<br/>stones, alongside exquisite rings and necklaces such as the STAR OF SHAMBALLA®<br/>Diamond Ring and the enchanting SHAMBALLA® Choker with a Solid Faceted<br/>Champagne Brown Diamond, set against 18K black rhodium-plated and rose gold.<br/>These pieces are perfect for those wishing to radiate elegance and sophistication<br/>during the cooler months.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "row_iw8FXe": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/inside_sj_necklace_3.jpg",
            "caption": "Customization",
            "heading": "Tailor Your Unique Piece",
            "text": "<p>Continue to personalize your jewelry with our customization service. Whether you desire a<br/>special gemstone, a unique combination of materials, or a personalized<br/>engraving, we work closely with you to bring your vision to life, ensuring<br/>luxury is personal and intimately tailored to your preferences.</p>",
            "button_label": "Learn more",
            "button_link": "shopify://pages/the-creator"
          }
        }
      },
