        "row_36zCdj": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/Webshop_still_life_compressed2.webp",
            "caption": "Discover our",
            "heading": "Lock bracelets",
            "text": "<p>Experience elegance and security with our Lock Bracelets. These designs showcase innovative locking mechanisms and exquisite materials, offering both style and functionality for the modern individual. Crafted from 18K gold, they are ideal for those seeking sophistication and durability.</p>",
            "button_label": "Shop lock bracelets",
            "button_link": "shopify://collections/lock-bracelets-1"
          }
        },
        "row_XgeJTP": {
