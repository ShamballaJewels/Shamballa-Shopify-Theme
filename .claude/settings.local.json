{
  "permissions": {
    "allow": [
      "PowerShell(node --version)",
      "PowerShell(npm --version)",
      "PowerShell(winget --version)",
      "PowerShell(winget install --id Git.Git -e --source winget --accept-package-agreements --accept-source-agreements)",
      "PowerShell(winget install --id OpenJS.NodeJS.LTS -e --source winget --accept-package-agreements --accept-source-agreements)",
      "PowerShell($env:Path = [System.Environment]::GetEnvironmentVariable\\(\"Path\",\"Machine\"\\) + \";\" + [System.Environment]::GetEnvironmentVariable\\(\"Path\",\"User\"\\); git --version)",
      "PowerShell(git config --global user.email 2>$null)",
      "PowerShell(git config --global user.name 2>$null)",
      "PowerShell($gitPath = \"C:\\\\Program Files\\\\Git\\\\cmd\"; if \\(Test-Path $gitPath\\) { [Environment]::SetEnvironmentVariable\\(\"Path\", [Environment]::GetEnvironmentVariable\\(\"Path\",\"User\"\\) + \";\" + $gitPath, \"User\"\\); Write-Output \"added\" } else { Write-Output \"not found at expected path\" })"
    ]
  }
}
